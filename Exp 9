import re

sentence = input("Enter sentence: ").split()

for word in sentence:
    if re.search(r'ing$', word):
        tag = "VBG"
    elif re.search(r'ed$', word):
        tag = "VBD"
    elif re.search(r'ly$', word):
        tag = "RB"
    elif re.search(r's$', word):
        tag = "NNS"
    else:
        tag = "NN"

    print(word, ":", tag)
