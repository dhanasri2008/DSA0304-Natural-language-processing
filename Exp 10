sentence = input("Enter sentence: ").split()

# Initial tagging
tags = []

for word in sentence:
    if word.endswith("ing"):
        tags.append((word, "NN"))
    else:
        tags.append((word, "NN"))

# Transformation rule
new_tags = []

for word, tag in tags:
    if word.endswith("ing"):
        tag = "VBG"

    new_tags.append((word, tag))

