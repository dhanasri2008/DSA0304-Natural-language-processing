# Deterministic Finite Automata (DFA) Simulator
# Language: Strings ending with "ab"

# DFA Description
states = ["q0", "q1", "q2"]
alphabet = ["a", "b"]

transitions = {
    ("q0", "a"): "q1",
    ("q0", "b"): "q0",
    ("q1", "a"): "q1",
    ("q1", "b"): "q2",
    ("q2", "a"): "q1",
    ("q2", "b"): "q0"
}

initial_state = "q0"
final_states = ["q2"]

# Number of input strings
while True:
    try:
        n = int(input("Enter number of input strings: "))
        break
    except ValueError:
        print("Invalid input. Please enter an integer.")

for i in range(n):
    string = input(f"\nEnter string {i+1}: ")

    current_state = initial_state
    path = [current_state]
    valid = True

    for symbol in string:
        if symbol not in alphabet:
            valid = False
            break
        current_state = transitions[(current_state, symbol)]
        path.append(current_state)

    print("Transition Path:")
    print(" → ".join(path))

    if valid and current_state in final_states:
        print("Accepted")
    else:
        print("Rejected")
