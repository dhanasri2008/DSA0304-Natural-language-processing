import random

# Simple probability model
probabilities = {
    "book": [("NN", 0.7), ("VB", 0.3)],
    "can": [("MD", 0.6), ("NN", 0.4)],
    "run": [("VB", 0.8), ("NN", 0.2)]
}

sentence = input("Enter sentence: ").split()

for word in sentence:
    if word in probabilities:
        tags = probabilities[word]
        r = random.random()
        cumulative = 0
        for tag, prob in tags:
            cumulative += prob
            if r <= cumulative:
                print(word, "->", tag)
                break
    else:
        print(word, "->", "NN")
